{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Low-churn updates for finished projects: one grouped PR a month, security fixes right away, no major bumps, automerge once CI is green.",
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard",
    ":semanticPrefixFixDepsChoreOthers",
    "group:allNonMajor",
    "schedule:monthly"
  ],
  "labels": ["dependencies"],
  "rangeStrategy": "update-lockfile",
  "minimumReleaseAge": "3 days",
  "rebaseWhen": "conflicted",
  "prConcurrentLimit": 2,
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Majors wait for a reason (security, breakage); a frozen project doesn't chase them.",
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["dependencies", "security"],
    "automerge": true
  }
}
